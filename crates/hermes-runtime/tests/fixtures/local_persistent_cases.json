          "command": "echo \"v=$DEMO_VAR\"",
          "output": "v=world\n",
          "returncode": 0,
          "cwd": "<ROOT>"
        },
        {
          "command": "unset DEMO_VAR",
          "output": "",
          "returncode": 0,
          "cwd": "<ROOT>"
        },
        {
          "command": "echo \"v=${DEMO_VAR:-unset}\"",
          "output": "v=unset\n",
          "returncode": 0,
          "cwd": "<ROOT>"
        }
      ]
